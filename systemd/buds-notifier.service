[Unit]
Description=Galaxy Buds notifier
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# System python: it has python3-gi and python3-dbus (a python3 earlier in PATH may not).
ExecStart=/usr/bin/python3 -m buds_notifier
# install.sh fills in the repository path below.
WorkingDirectory=@REPO_DIR@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
